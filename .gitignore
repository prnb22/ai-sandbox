```gitignore
# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.env/
.venv/
env/

# Conda
*.conda
conda-meta/
environment.yml

# ==========================
# IDE / Editor
# ==========================
.vscode/
.idea/
*.swp
*.swo

# ==========================
# Jupyter Notebook
# ==========================
.ipynb_checkpoints/

# ==========================
# OS Files
# ==========================
.DS_Store
Thumbs.db

# ==========================
# Logs
# ==========================
*.log
logs/

# ==========================
# Environment Variables / Secrets
# ==========================
.env
.env.local
*.env

# API Keys
config/secrets.py
secrets.json

# ==========================
# Data Files
# Keep sample docs small only
# ==========================
data/raw/*
data/processed/*

# keep folders tracked
!data/raw/.gitkeep
!data/processed/.gitkeep

# ==========================
# Vector Databases
# ==========================
chroma_db/
qdrant_storage/

# FAISS
*.faiss

# Pinecone local cache (if any temp files)
pinecone_cache/

# ==========================
# Model Files
# ==========================
models/
checkpoints/
*.bin
*.pt
*.pth
*.safetensors

# HuggingFace cache
.cache/
huggingface/

# Ollama generated files (local experiments)
ollama_models/

# ==========================
# Build / Distribution
# ==========================
build/
dist/
*.egg-info/

# ==========================
# Testing
# ==========================
.pytest_cache/
.coverage
htmlcov/

# ==========================
# Temporary Files
# ==========================
tmp/
temp/
*.tmp

# ==========================
# Docker
# ==========================
docker-compose.override.yml

# ==========================
# Database Files
# ==========================
*.sqlite3
*.db

# ==========================
# Misc
# ==========================
*.bak
*.zip
```
